local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- Вставь сюда свой загруженный ID иконки с буквой K (например: "rbxassetid://1234567890")
local ICON_ASSET_ID = ""

local FULL_WIDTH = 520
local FULL_HEIGHT = 310
local TOP_HEIGHT = 36

local OFF_COLOR = Color3.fromRGB(38, 38, 46)
local ON_GREEN_COLOR = Color3.fromRGB(32, 165, 85)

local function buildKornoxHub()
	if PlayerGui:FindFirstChild("KornoxHubGui") then
		PlayerGui.KornoxHubGui:Destroy()
	end

	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "KornoxHubGui"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	ScreenGui.Parent = PlayerGui

	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "MainFrame"
	MainFrame.Size = UDim2.new(0, FULL_WIDTH, 0, FULL_HEIGHT)
	MainFrame.Position = UDim2.new(0.5, -FULL_WIDTH / 2, 0.5, -FULL_HEIGHT / 2)
	MainFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
	MainFrame.BorderSizePixel = 0
	MainFrame.Active = true
	MainFrame.ClipsDescendants = true
	MainFrame.Parent = ScreenGui

	local MainCorner = Instance.new("UICorner")
	MainCorner.CornerRadius = UDim.new(0, 8)
	MainCorner.Parent = MainFrame

	local MainStroke = Instance.new("UIStroke")
	MainStroke.Color = Color3.fromRGB(55, 55, 65)
	MainStroke.Thickness = 1
	MainStroke.Parent = MainFrame

	local TopBar = Instance.new("Frame")
	TopBar.Name = "TopBar"
	TopBar.Size = UDim2.new(1, 0, 0, TOP_HEIGHT)
	TopBar.BackgroundColor3 = Color3.fromRGB(16, 16, 19)
	TopBar.BorderSizePixel = 0
	TopBar.Active = true
	TopBar.ZIndex = 3
	TopBar.Parent = MainFrame

	local TopCorner = Instance.new("UICorner")
	TopCorner.CornerRadius = UDim.new(0, 8)
	TopCorner.Parent = TopBar

	local IconLabel = Instance.new("ImageLabel")
	IconLabel.Size = UDim2.new(0, 22, 0, 22)
	IconLabel.Position = UDim2.new(0, 10, 0.5, -11)
	IconLabel.BackgroundColor3 = Color3.fromRGB(235, 35, 95)
	IconLabel.BorderSizePixel = 0
	IconLabel.Image = ICON_ASSET_ID
	IconLabel.ZIndex = 4
	IconLabel.Parent = TopBar

	local IconCorner = Instance.new("UICorner")
	IconCorner.CornerRadius = UDim.new(0, 4)
	IconCorner.Parent = IconLabel

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.Size = UDim2.new(1, -110, 1, 0)
	TitleLabel.Position = UDim2.new(0, 40, 0, 0)
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Text = "Kornox Hub"
	TitleLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
	TitleLabel.TextSize = 15
	TitleLabel.Font = Enum.Font.GothamBold
	TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	TitleLabel.ZIndex = 4
	TitleLabel.Parent = TopBar

	local MinimizeBtn = Instance.new("TextButton")
	MinimizeBtn.Name = "MinimizeBtn"
	MinimizeBtn.Size = UDim2.new(0, 28, 0, 26)
	MinimizeBtn.Position = UDim2.new(1, -66, 0.5, -13)
	MinimizeBtn.BackgroundColor3 = Color3.fromRGB(34, 34, 42)
	MinimizeBtn.Text = "-"
	MinimizeBtn.TextColor3 = Color3.fromRGB(230, 230, 235)
	MinimizeBtn.TextSize = 18
	MinimizeBtn.Font = Enum.Font.GothamBold
	MinimizeBtn.Active = true
	MinimizeBtn.ZIndex = 5
	MinimizeBtn.Parent = TopBar

	local MinCorner = Instance.new("UICorner")
	MinCorner.CornerRadius = UDim.new(0, 6)
	MinCorner.Parent = MinimizeBtn

	local CloseBtn = Instance.new("TextButton")
	CloseBtn.Name = "CloseBtn"
	CloseBtn.Size = UDim2.new(0, 28, 0, 26)
	CloseBtn.Position = UDim2.new(1, -34, 0.5, -13)
	CloseBtn.BackgroundColor3 = Color3.fromRGB(60, 24, 30)
	CloseBtn.Text = "X"
	CloseBtn.TextColor3 = Color3.fromRGB(255, 115, 125)
	CloseBtn.TextSize = 13
	CloseBtn.Font = Enum.Font.GothamBold
	CloseBtn.Active = true
	CloseBtn.ZIndex = 5
	CloseBtn.Parent = TopBar

	local CloseCorner = Instance.new("UICorner")
	CloseCorner.CornerRadius = UDim.new(0, 6)
	CloseCorner.Parent = CloseBtn

	local dragging = false
	local dragStart, startPos

	TopBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = MainFrame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			MainFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	local BodyFrame = Instance.new("Frame")
	BodyFrame.Name = "BodyFrame"
	BodyFrame.Size = UDim2.new(1, 0, 1, -TOP_HEIGHT)
	BodyFrame.Position = UDim2.new(0, 0, 0, TOP_HEIGHT)
	BodyFrame.BackgroundTransparency = 1
	BodyFrame.ZIndex = 2
	BodyFrame.Parent = MainFrame

	local Sidebar = Instance.new("Frame")
	Sidebar.Size = UDim2.new(0, 140, 1, 0)
	Sidebar.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	Sidebar.BorderSizePixel = 0
	Sidebar.ZIndex = 2
	Sidebar.Parent = BodyFrame

	local SidebarLayout = Instance.new("UIListLayout")
	SidebarLayout.Padding = UDim.new(0, 6)
	SidebarLayout.Parent = Sidebar

	local SidebarPad = Instance.new("UIPadding")
	SidebarPad.PaddingTop = UDim.new(0, 10)
	SidebarPad.PaddingLeft = UDim.new(0, 8)
	SidebarPad.PaddingRight = UDim.new(0, 8)
	SidebarPad.Parent = Sidebar

	local ContentArea = Instance.new("Frame")
	ContentArea.Size = UDim2.new(1, -140, 1, 0)
	ContentArea.Position = UDim2.new(0, 140, 0, 0)
	ContentArea.BackgroundColor3 = Color3.fromRGB(26, 26, 31)
	ContentArea.BorderSizePixel = 0
	ContentArea.ZIndex = 2
	ContentArea.Parent = BodyFrame

	local ContentPad = Instance.new("UIPadding")
	ContentPad.PaddingTop = UDim.new(0, 12)
	ContentPad.PaddingLeft = UDim.new(0, 12)
	ContentPad.PaddingRight = UDim.new(0, 12)
	ContentPad.PaddingBottom = UDim.new(0, 12)
	ContentPad.Parent = ContentArea

	local pages = {}
	local tabButtons = {}

	local function createTab(tabName)
		local page = Instance.new("ScrollingFrame")
		page.Name = tabName .. "Page"
		page.Size = UDim2.new(1, 0, 1, 0)
		page.BackgroundTransparency = 1
		page.ScrollBarThickness = 4
		page.CanvasSize = UDim2.new(0, 0, 0, 380)
		page.Visible = false
		page.ZIndex = 3
		page.Parent = ContentArea

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 8)
		layout.Parent = page

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 32)
		btn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
		btn.Text = tabName
		btn.TextColor3 = Color3.fromRGB(180, 180, 190)
		btn.TextSize = 13
		btn.Font = Enum.Font.GothamMedium
		btn.ZIndex = 3
		btn.Parent = Sidebar

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn

		btn.MouseButton1Click:Connect(function()
			for name, p in pairs(pages) do
				p.Visible = (name == tabName)
			end
			for name, b in pairs(tabButtons) do
				b.BackgroundColor3 = (name == tabName) and Color3.fromRGB(50, 50, 62) or Color3.fromRGB(28, 28, 34)
				b.TextColor3 = (name == tabName) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 190)
			end
		end)

		pages[tabName] = page
		tabButtons[tabName] = btn
		return page
	end

	local function addButton(page, text, callback)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -6, 0, 34)
		b.BackgroundColor3 = OFF_COLOR
		b.Text = text
		b.TextColor3 = Color3.fromRGB(235, 235, 240)
		b.TextSize = 13
		b.Font = Enum.Font.Gotham
		b.ZIndex = 3
		b.Parent = page

		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 6)
		c.Parent = b

		b.MouseButton1Click:Connect(function()
			pcall(callback)
		end)
		return b
	end

	local MainPage = createTab("Main")
	local PlayerPage = createTab("Player")
	local MiscPage = createTab("Misc")

	PlayerPage.Visible = true
	tabButtons["Player"].BackgroundColor3 = Color3.fromRGB(50, 50, 62)
	tabButtons["Player"].TextColor3 = Color3.fromRGB(255, 255, 255)

	local speedList = {16, 32, 60, 100, 200, 300}
	local speedIdx = 1
	local currentSpeed = 16

	local jumpList = {50, 100, 150, 220}
	local jumpIdx = 1
	local currentJump = 50

	local infJump = false
	local flyOn = false
	local farmFlyOn = false
	local noclipOn = false
	local flyBv = nil
	local farmPad = nil
	local farmPos = nil

	local function getCharParts()
		local c = Player.Character
		if not c then return nil, nil end
		return c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
	end

	local function removeFlyBv()
		if flyBv then
			flyBv:Destroy()
			flyBv = nil
		end
	end

	local function removeFarmPad()
		if farmPad then
			farmPad:Destroy()
			farmPad = nil
		end
	end

	local function applyNoClipToChar(char)
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	local function stepBarrierPass(char, root, hum)
		if not char or not root or not hum then return end
		local move = hum.MoveDirection
		if move.Magnitude > 0.05 then
			local flatMove = Vector3.new(move.X, 0, move.Z)
			if flatMove.Magnitude > 0.01 then
				local stepVec = flatMove.Unit * 1.35
				local hitPart = workspace:FindPartOnRayWithIgnoreList(
					Ray.new(root.Position, stepVec),
					{char, farmPad}
				)
				if hitPart and hitPart.CanCollide == false or hitPart then
					local speedScale = (currentSpeed > 16) and math.clamp(currentSpeed / 60, 1, 3.5) or 1
					root.CFrame = root.CFrame + (flatMove.Unit * (1.25 * speedScale))
				end
			end
		end
	end

	local function applyStats()
		local _, hum = getCharParts()
		if hum then
			hum.WalkSpeed = currentSpeed
			pcall(function()
				hum.UseJumpPower = true
				hum.JumpPower = currentJump
			end)
		end
	end

	local speedBtn
	speedBtn = addButton(PlayerPage, "Speed: 16", function()
		speedIdx = speedIdx + 1
		if speedIdx > #speedList then speedIdx = 1 end
		currentSpeed = speedList[speedIdx]
		speedBtn.Text = "Speed: " .. tostring(currentSpeed)
		speedBtn.BackgroundColor3 = (currentSpeed ~= 16) and ON_GREEN_COLOR or OFF_COLOR
		applyStats()
	end)

	local jumpPowBtn
	jumpPowBtn = addButton(PlayerPage, "JumpPower: Normal (50)", function()
		jumpIdx = jumpIdx + 1
		if jumpIdx > #jumpList then jumpIdx = 1 end
		currentJump = jumpList[jumpIdx]
		if currentJump == 50 then
			jumpPowBtn.Text = "JumpPower: Normal (50)"
			jumpPowBtn.BackgroundColor3 = OFF_COLOR
		else
			jumpPowBtn.Text = "JumpPower: " .. tostring(currentJump)
			jumpPowBtn.BackgroundColor3 = ON_GREEN_COLOR
		end
		applyStats()
	end)

	local infJumpBtn
	infJumpBtn = addButton(PlayerPage, "Infinity Jump: OFF", function()
		infJump = not infJump
		infJumpBtn.Text = "Infinity Jump: " .. (infJump and "ON" or "OFF")
		infJumpBtn.BackgroundColor3 = infJump and ON_GREEN_COLOR or OFF_COLOR
	end)

	local flyBtn
	local farmFlyBtn
	flyBtn = addButton(PlayerPage, "Fly: OFF", function()
		flyOn = not flyOn
		flyBtn.Text = "Fly: " .. (flyOn and "ON" or "OFF")
		flyBtn.BackgroundColor3 = flyOn and ON_GREEN_COLOR or OFF_COLOR
		if flyOn then
			farmFlyOn = false
			if farmFlyBtn then
				farmFlyBtn.Text = "FarmFly (+900): OFF"
				farmFlyBtn.BackgroundColor3 = OFF_COLOR
			end
			removeFarmPad()
			local root = select(1, getCharParts())
			if root then
				removeFlyBv()
				flyBv = Instance.new("BodyVelocity")
				flyBv.Name = "KornoxFlyVel"
				flyBv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
				flyBv.Velocity = Vector3.zero
				flyBv.Parent = root
			end
		else
			removeFlyBv()
		end
	end)

	farmFlyBtn = addButton(PlayerPage, "FarmFly (+900): OFF", function()
		farmFlyOn = not farmFlyOn
		farmFlyBtn.Text = "FarmFly (+900): " .. (farmFlyOn and "ON" or "OFF")
		farmFlyBtn.BackgroundColor3 = farmFlyOn and ON_GREEN_COLOR or OFF_COLOR
		if farmFlyOn then
			flyOn = false
			flyBtn.Text = "Fly: OFF"
			flyBtn.BackgroundColor3 = OFF_COLOR
			removeFlyBv()
			local root = select(1, getCharParts())
			if root then
				farmPos = root.Position + Vector3.new(0, 900, 0)
				removeFarmPad()
				farmPad = Instance.new("Part")
				farmPad.Name = "KornoxFarmPad"
				farmPad.Size = Vector3.new(14, 1, 14)
				farmPad.Anchored = true
				farmPad.CanCollide = true
				farmPad.Transparency = 0.7
				farmPad.Position = farmPos - Vector3.new(0, 3.5, 0)
				farmPad.Parent = workspace
				root.CFrame = CFrame.new(farmPos)
			end
		else
			farmPos = nil
			removeFarmPad()
		end
	end)

	local noclipBtn
	noclipBtn = addButton(PlayerPage, "NoClip: OFF", function()
		noclipOn = not noclipOn
		noclipBtn.Text = "NoClip: " .. (noclipOn and "ON" or "OFF")
		noclipBtn.BackgroundColor3 = noclipOn and ON_GREEN_COLOR or OFF_COLOR
		if noclipOn then
			applyNoClipToChar(Player.Character)
		end
	end)

	addButton(MainPage, "Apply Speed & Jump", function()
		applyStats()
	end)

	addButton(MiscPage, "Rejoin Server", function()
		TeleportService:Teleport(game.PlaceId, Player)
	end)

	UserInputService.JumpRequest:Connect(function()
		if infJump then
			local _, hum = getCharParts()
			if hum then
				hum.Jump = true
				pcall(function()
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end)
			end
		end
	end)

	RunService.Stepped:Connect(function()
		if noclipOn then
			local char = Player.Character
			local root, hum = getCharParts()
			applyNoClipToChar(char)
			stepBarrierPass(char, root, hum)
		end
	end)

	RunService.RenderStepped:Connect(function()
		local char = Player.Character
		local root, hum = getCharParts()

		if hum then
			if currentSpeed ~= 16 then
				if hum.WalkSpeed ~= currentSpeed then
					hum.WalkSpeed = currentSpeed
				end
				if not flyOn and not farmFlyOn and root and hum.MoveDirection.Magnitude > 0.05 then
					local flatDir = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
					if flatDir.Magnitude > 0.01 then
						local wishVel = flatDir.Unit * currentSpeed
						root.AssemblyLinearVelocity = Vector3.new(wishVel.X, root.AssemblyLinearVelocity.Y, wishVel.Z)
					end
				end
			end
			if currentJump ~= 50 then
				pcall(function()
					hum.UseJumpPower = true
					hum.JumpPower = currentJump
				end)
			end
		end

		if noclipOn and char then
			applyNoClipToChar(char)
		end

		if flyOn and root and hum then
			if not flyBv or flyBv.Parent ~= root then
				removeFlyBv()
				flyBv = Instance.new("BodyVelocity")
				flyBv.Name = "KornoxFlyVel"
				flyBv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
				flyBv.Parent = root
			end
			local cam = workspace.CurrentCamera
			local move = hum.MoveDirection
			local spd = (currentSpeed > 16) and currentSpeed or 50
			if move.Magnitude > 0.05 and cam then
				local look = cam.CFrame.LookVector
				local right = cam.CFrame.RightVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end
				local flatRight = Vector3.new(right.X, 0, right.Z)
				if flatRight.Magnitude > 0.01 then flatRight = flatRight.Unit end
				local dir = look * move:Dot(flatLook) + flatRight * move:Dot(flatRight)
				flyBv.Velocity = (dir.Magnitude > 0.01) and (dir.Unit * spd) or Vector3.zero
			else
				flyBv.Velocity = Vector3.zero
			end
		else
			removeFlyBv()
		end

		if farmFlyOn and root and farmPos then
			if (root.Position - farmPos).Magnitude > 2 then
				root.CFrame = CFrame.new(farmPos)
			end
		end
	end)

	local minimized = false
	MinimizeBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		BodyFrame.Visible = not minimized
		MinimizeBtn.Text = minimized and "+" or "-"
		MainFrame.Size = UDim2.new(0, FULL_WIDTH, 0, minimized and TOP_HEIGHT or FULL_HEIGHT)
	end)

	CloseBtn.MouseButton1Click:Connect(function()
		dragging = false
		flyOn = false
		farmFlyOn = false
		noclipOn = false
		infJump = false
		removeFlyBv()
		removeFarmPad()
		ScreenGui:Destroy()
	end)
end

pcall(buildKornoxHub)
